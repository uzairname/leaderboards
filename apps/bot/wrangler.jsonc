{
  "main": "src/index.ts",
  "compatibility_date": "2025-08-19",
  "minify": false,
  "compatibility_flags": [
    "nodejs_als"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "development": {
      "name": "leaderboards-dev",
      "vars": {
        "ENVIRONMENT": "development",
        "BASE_URL": "https://leaderboards-dev.5r.workers.dev"
      },
      "version_metadata": { 
        "binding": "CF_VERSION_METADATA",
        "experimental_remote": true
      }
    },
    "production": {
      "name": "leaderboards",
      "vars": {
        "ENVIRONMENT": "production",
        "BASE_URL": "https://leaderboards.5r.workers.dev"
      },
      "version_metadata": { 
        "binding": "CF_VERSION_METADATA",
        "experimental_remote": true
      }
    }
  }
}
